{
  "name": "valueverdict-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "research": "esbuild scripts/research.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/research.mjs --log-level=warning && node node_modules/.cache/research.mjs",
    "research:local": "esbuild scripts/research.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/research.mjs --log-level=warning && node --env-file=.env.local --dns-result-order=ipv4first node_modules/.cache/research.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "esbuild": "0.25.12"
  }
}
