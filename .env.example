# Copy to .env.local (never committed) and fill in. On Netlify: Site configuration → Environment variables.

# Supabase Postgres: Connect → Transaction pooler (port 6543)
DATABASE_URL=

# Amazon Creators API (Associates Central → Tools → Creators API → your app)
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# optional
# AMAZON_PARTNER_TAG=valueverdic03-21
# AMAZON_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token

# Supabase secret key (sb_secret_...), used only by the scheduled deal refresh. Never expose it in pages.
SUPABASE_SECRET_KEY=

# Anthropic API key (sk-ant-...), used only by the scheduled AI deal picks.
ANTHROPIC_API_KEY=
